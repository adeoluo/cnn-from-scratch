flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client(["HTTP client"]):::edge
    CLI(["CLI<br/>train, evaluate, serve"]):::edge

    subgraph Interfaces["Interfaces (stdlib HTTP service)"]
        direction TB
        Router["Router<br/>/health, /ready, /metrics,<br/>/classify, /evaluate"]:::edge
        Validate["Validation<br/>8x8 numeric image"]:::control
    end

    subgraph Training["Training (once at startup)"]
        direction TB
        Loss["Cross-entropy gradient<br/>on softmax logits"]:::core
        Adam["Adam optimizer<br/>from scratch"]:::control
    end

    subgraph Net["Sequential CNN (forward caches, reverse backward)"]
        direction TB
        Conv["Conv2D + ReLU<br/>6 filters, 3x3, He init"]:::core
        Pool["MaxPool2D<br/>argmax cached"]:::core
        Dense["Flatten + Dense<br/>logits per class"]:::core
    end

    subgraph State["Data and state (in memory, seeded)"]
        direction TB
        TrainData[("Training images<br/>oriented strokes, noise")]:::data
        TestData[("Test images<br/>disjoint seed")]:::data
        Params[("Parameters<br/>conv and dense weights + grads")]:::data
    end

    subgraph Evaluation["Evaluation and outputs"]
        direction TB
        Probs["Prediction<br/>class + softmax probabilities"]:::obs
        Report["EvalReport<br/>accuracy, confusion matrix"]:::obs
        Baseline["Logistic regression<br/>linear baseline"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus"]:::obs
    end

    Client -->|JSON image| Router
    CLI -->|serve| Router
    CLI -->|train, evaluate| Loss
    Router --> Validate
    Validate -->|image| Conv
    Loss -->|backward| Conv
    Adam -.->|step| Params
    Conv --> Pool
    Pool --> Dense
    Conv -.-> Params
    Dense -.-> Params
    Loss -.->|reads| TrainData
    Dense -->|logits| Probs
    Dense -->|test logits| Report
    Report -.->|reads| TestData
    Baseline -.->|reads| TestData
    Router -.-> Metrics
