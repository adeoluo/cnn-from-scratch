flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Client([HTTP client]):::edge
        CLI(["CLI<br/>train, evaluate, serve"]):::edge
        Router["Router<br/>/classify, /evaluate"]:::edge
        Validate["Validation<br/>8x8 numeric image"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph State["Data and state (seeded)"]
        direction TB
        TrainData[("Training images<br/>oriented strokes")]:::data
        TestData[("Test images<br/>disjoint seed")]:::data
        Params[("Parameters<br/>weights + grads")]:::data
        TrainData ~~~ TestData ~~~ Params
    end

    subgraph Core["Sequential CNN"]
        direction TB
        Conv["Conv2D + ReLU<br/>6 filters, 3x3"]:::core
        Pool["MaxPool2D<br/>argmax cached"]:::core
        Dense["Flatten + Dense<br/>class logits"]:::core
        Loss["Cross-entropy<br/>gradient, backward"]:::core
        Adam["Adam optimizer<br/>from scratch"]:::control
        Conv --> Pool --> Dense --> Loss --> Adam
    end

    subgraph Obs["Evaluation and outputs"]
        direction TB
        Probs["Prediction<br/>softmax probabilities"]:::obs
        Report["EvalReport<br/>accuracy, confusion"]:::obs
        Baseline["Logistic regression<br/>linear baseline"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus"]:::obs
        Probs ~~~ Report
        Baseline ~~~ Metrics
    end

    Interfaces -->|8x8 image| Core
    State -.->|images, weights| Core
    Core -->|logits| Obs
