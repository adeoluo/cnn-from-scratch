---
title: System Architecture - CNN From Scratch
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#EEF2FF"
    clusterBorder: "#94A3B8"
---
flowchart TB
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client([Client]):::edge

    subgraph Net["Convolutional classifier (explicit forward and backward per layer)"]
        direction TB
        Conv["Conv2D<br/>sliding filters, valid convolution"]:::core
        Relu["ReLU"]:::core
        Pool["MaxPool2D<br/>argmax cached for backward"]:::core
        Flat["Flatten"]:::core
        Dense["Dense + softmax"]:::core
    end

    subgraph TrainLoop["Training (once at startup)"]
        direction TB
        Data[(Oriented-stroke images<br/>random positions, seeded, disjoint splits)]:::data
        Loss["Cross-entropy gradient"]:::control
        Adam["Adam optimizer<br/>from scratch"]:::control
    end

    Weights[(Conv + dense weights)]:::data

    subgraph Edge["Service layer (stdlib HTTP, stateless)"]
        direction TB
        Router["Router<br/>/health | /ready | /metrics | /classify | /evaluate"]:::core
        Validate["Validation<br/>fixed-size numeric image"]:::control
    end

    Result["Predicted class + probabilities"]:::obs

    Conv --> Relu --> Pool --> Flat --> Dense
    Data --> Net
    Dense -->|logits| Loss --> Adam -->|updates| Weights
    Net -.->|backward| Loss
    Net -.-> Weights

    Client -->|JSON image| Router --> Validate
    Validate -->|image| Net
    Weights -.-> Net
    Net -->|probabilities| Result
    Result --> Router -->|JSON response| Client
